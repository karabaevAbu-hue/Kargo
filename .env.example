# ===== Доступ =====
# Токен бота от @BotFather (для @XAUEnginePro2Bot). Без него бот не стартует, кроме режима DRY_RUN.
BOT_TOKEN=
# Кому можно пользоваться ботом (id через запятую). Пусто = любой, кто нажмёт /start.
# Для личного бота ОБЯЗАТЕЛЬНО укажи свой id (узнать: @userinfobot).
ALLOWED_USER_IDS=
# Секрет вебхука (нужен только для варианта A). Тот же секрет вписывается в настройки индикатора. Без него вебхук выключен.
WEBHOOK_SECRET=

# ===== Режим расчёта =====
# B    — ОСНОВНОЙ СЕЙЧАС (бесплатно): сервер считает стратегию по свечам Twelve Data (нужен TWELVEDATA_API_KEY).
#        TradingView-индикатор нужен только для проверки зоны глазами.
# A    — на будущее, когда появится платный TradingView: анализ делает индикатор, сервер принимает вебхуки.
# BOTH — оба пути; дубли по пересекающимся зонам отсекаются.
MODE=B
TWELVEDATA_API_KEY=
TD_SYMBOL=XAU/USD
FEED_LABEL_A=OANDA
FEED_LABEL_B=Twelve Data
TV_SYMBOL=OANDA:XAUUSD

# ===== Сервер =====
HOST=0.0.0.0
PORT=8080
DB_PATH=data/xau_engine.sqlite3
# 1 — не отправлять в Telegram, печатать сообщения в лог (проверка без бота)
DRY_RUN=0

# ===== Настройки стратегии (раздел 6 ТЗ) =====
# 1 пункт = POINT_SIZE долларов цены золота. Подтверждено: 1.00 ($4100 -> $4101), зона максимум 10 $.
POINT_SIZE=1.0
ZONE_TARGET=5
ZONE_MAX=10
SL_BUFFER=1.5
SL_MAX=20
# Минимальный RR до TP1 (от середины зоны). off — не проверять.
MIN_RR=2
MAX_SIGNALS_DAY=3
# Срок жизни сигнала до входа: пусто = до 23:00 Бишкек, либо число часов.
SIGNAL_TTL_HOURS=
# Предел жизни сделки после входа
MAX_SIGNAL_AGE_H=36
# Зона дальше этого расстояния от цены не рассматривается (защитная настройка)
MAX_ZONE_DISTANCE=60

# Пороги, которых нет в слайдах Mr. Casino
DOJI_BODY_RATIO=0.10
BIG_WICK_RATIO=0.50
PERFECT_DOUBLE_TOL=0.5
BIG_IMBALANCE=3
MIN_ZONE_WIDTH=1.0
STRONG_BODY_RATIO=0.40
OB_MAX_WICK_RATIO=0.25
DISPLACEMENT_ATR=1.0
TRENDLINE_TOL=0.5
# Час UTC открытия дневной свечи для сборки H4 из M5. Пусто = 21 для MODE=A/BOTH (OANDA, ~17:00 Нью-Йорк;
# зимой 22) и 0 для MODE=B (Twelve Data режет сутки по UTC).
# DAY_OPEN_UTC_HOUR=21

# Тихие часы по Бишкеку: сообщения приходят без звука
QUIET_START=0
QUIET_END=8
SEND_WATCH=1
# «Анализ сейчас»: не чаще раза в N секунд
ANALYSIS_COOLDOWN_S=300
# Сопровождать сигналы индикатора ещё и по свечам M5 (по умолчанию — только события индикатора)
TRACK_A_FROM_BARS=0
