# Токен главного бота платформы (@BotFather)
MASTER_BOT_TOKEN=
# Адрес сервера с HTTPS, без слеша в конце
BASE_URL=https://cargo.example.kg
# Ключ шифрования токенов: python -m cargo_platform.tools.genkey
FERNET_KEY=
# Секрет webhook главного бота: любая длинная случайная строка
MASTER_WEBHOOK_SECRET=
# Ваш Telegram ID (узнать: @userinfobot)
PLATFORM_ADMINS=
# Ваш username для кнопки «Поддержка» (без @)
SUPPORT_USERNAME=
# На ноутбуке — SQLite, в Docker — PostgreSQL (см. docker-compose.yml)
DATABASE_URL=sqlite+aiosqlite:///cargo.db
POSTGRES_PASSWORD=change-me
